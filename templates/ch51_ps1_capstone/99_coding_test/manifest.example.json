{
  "description": "ch51 capstone EXAMPLE manifest (not executed by default): protocol/state checks against the student's integrated emulator via {{env:LABS_CAPSTONE_BIN}}. Fixture ROMs/scripts are produced at final grading time from the course fixture set; hashes are pinned there. The always-on executable manifest lives in tests/hidden/ch51_ps1_capstone/manifest.json and contains only the pipeline self-check.",
  "cases": [
    {
      "name": "capstone_cpu_trace",
      "binary": "{{env:LABS_CAPSTONE_BIN}}",
      "args": ["--rom", "tests/hidden/ch51_ps1_capstone/roms/cpu_smoke.bin",
               "--trace", "{{tmp}}/cpu.trace", "--cycles", "20000", "--headless"],
      "expect_file_hash": {"file": "{{tmp}}/cpu.trace", "fnv64": "PINNED_AT_GRADING"}
    },
    {
      "name": "capstone_dma_chain_state",
      "binary": "{{env:LABS_CAPSTONE_BIN}}",
      "args": ["--rom", "tests/hidden/ch51_ps1_capstone/roms/dma_chain.bin",
               "--cycles", "100000", "--headless"],
      "expect_exit": 0
    },
    {
      "name": "capstone_gte_vector",
      "binary": "{{env:LABS_CAPSTONE_BIN}}",
      "args": ["--rom", "tests/hidden/ch51_ps1_capstone/roms/gte_vector.bin",
               "--hash-frame", "{{tmp}}/gte.bin", "--headless"],
      "expect_file_hash": {"file": "{{tmp}}/gte.bin", "fnv64": "PINNED_AT_GRADING"}
    },
    {
      "name": "capstone_timer_irq_order",
      "binary": "{{env:LABS_CAPSTONE_BIN}}",
      "args": ["--rom", "tests/hidden/ch51_ps1_capstone/roms/irq_order.bin",
               "--hash-frame", "{{tmp}}/evt.log", "--headless"],
