{
  "description": "ch09 hidden gates: SI-compatible diagnostic boot (state + frame hash), cadence trace determinism, Arcade-8080-B unseen-board bring-up (ports, IRQ cadence, video), debug regression",
  "cases": [
    {
      "name": "challenge_diag_state",
      "binary": "build/skels/ch09_space_invaders_machine/91_challenge/ch09_91_si_runner",
      "args": [
        "--rom",
        "tests/public/ch09_space_invaders_machine/roms/ch09_si_diag.bin",
        "--frames",
        "6",
        "--input-file",
        "tests/public/ch09_space_invaders_machine/input/ch09_si_diag.inputs"
      ],
      "expect_stdout_contains": "AF=0046 BC=0000 DE=0000 HL=0000 SP=2100 PC=007E cyc=161702"
    },
    {
      "name": "challenge_diag_frame_hash",
      "binary": "build/skels/ch09_space_invaders_machine/91_challenge/ch09_91_si_runner",
      "args": [
        "--rom",
        "tests/public/ch09_space_invaders_machine/roms/ch09_si_diag.bin",
        "--frames",
        "6",
        "--input-file",
        "tests/public/ch09_space_invaders_machine/input/ch09_si_diag.inputs",
        "--hash-frame",
        "{{tmp}}/diag.rgba"
      ],
      "expect_file_hash": {
        "file": "{{tmp}}/diag.rgba",
        "fnv64": "7B652C7D5C382925"
      }
    },
    {
      "name": "cadence_trace_golden",
