        "--cpf",
        "500",
        "--frames",
        "6",
        "--trace",
        "{{tmp}}/t.log"
      ],
      "expect_file_hash": {
        "file": "{{tmp}}/t.log",
        "fnv64": "9914B5E36957A739"
      }
