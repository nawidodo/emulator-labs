{
  "description": "ch17 hidden grading: APU channel accuracy via golden PCM hashes through the student's 04 runner",
  "cases": [
    {
      "name": "hidden_square_sweep",
      "binary": "build/skels/ch17_gameboy_audio_accuracy/04_mixer_apu/ch17_04_apu_runner",
      "args": [
        "--rom",
        "tests/hidden/ch17_gameboy_audio_accuracy/fixtures/h1_square_sweep.apuprog",
        "--frames",
        "4",
        "--headless",
        "--audio-out",
        "{{tmp}}/h1.pcm"
      ],
      "expect_exit": 0,
      "expect_stdout_contains": "simulated 280896 T-cycles",
      "expect_file_hash": {
        "file": "{{tmp}}/h1.pcm",
        "fnv64": "72E43F50189780DD"
      }
    },
