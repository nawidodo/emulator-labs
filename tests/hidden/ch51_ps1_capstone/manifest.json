{
  "description": "ch51 PS1 capstone learner gate \u2014 requires your integrated emulator via LABS_CAPSTONE_BIN Hash pinning: pending canonical reference.",
  "cases": [
    {
      "name": "capstone_cpu_trace",
      "binary": "{{env:LABS_CAPSTONE_BIN}}",
      "args": [
        "--rom",
        "tests/hidden/ch51_ps1_capstone/roms/cpu_smoke.bin",
        "--trace",
        "{{tmp}}/cpu.trace",
        "--cycles",
        "20000",
        "--headless"
      ],
      "required_env": true,
      "expect_exit": 0,
      "expect_file_exists": [
        "{{tmp}}/cpu.trace"
      ]
    },
    {
      "name": "capstone_dma_chain_state",
