{
  "description": "ch51 PS1 capstone learner gate - all ten canonical cases pinned to independently validated reference output (see tests/public/ch51_ps1_capstone/goldens/provenance.md)",
  "cases": [
    {
      "name": "capstone_pad_transaction",
      "binary": "{{env:LABS_CAPSTONE_BIN}}",
      "required_env": true,
      "args": [
        "--rom",
        "tests/hidden/ch51_ps1_capstone/roms/pad_txn.bin",
        "--headless",
        "--hash-frame",
        "{{tmp}}/resp.bin"
      ],
      "expect_exit": 0,
      "expect_file_exists": [
        "{{tmp}}/resp.bin"
      ],
      "expect_file_hash": {
        "file": "{{tmp}}/resp.bin",
        "fnv64": "828A0EACD822DFAA"
      }
