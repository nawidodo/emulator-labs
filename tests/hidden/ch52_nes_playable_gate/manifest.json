{
  "description": "ch52 playable-NES learner gate — requires your composed machine via LABS_NES_GATE_BIN.",
  "cases": [
    {
      "name": "gate_boot_and_video_golden",
      "binary": "{{env:LABS_NES_GATE_BIN}}",
      "args": [
        "--rom",
        "tests/public/ch52_nes_playable_gate/roms/gate_homebrew.nes",
        "--input-file",
        "tests/public/ch52_nes_playable_gate/scripts/play.input",
        "--frames",
        "180",
        "--headless",
        "--hash-frame",
        "{{tmp}}/f.rgba"
      ],
      "expect_exit": 0,
      "required_env": true,
      "expect_file_hash": { "file": "{{tmp}}/f.rgba", "fnv64": "9907513AFD961865" },
      "note": "pinned to the canonical reference checkpoint (EMU_GATE_V1) at goldens/gate_reference.emu_gate"
    },
    {
      "name": "gate_audio_segment_golden",
      "binary": "{{env:LABS_NES_GATE_BIN}}",
      "args": [
        "--rom",
        "tests/public/ch52_nes_playable_gate/roms/gate_homebrew.nes",
        "--input-file",
        "tests/public/ch52_nes_playable_gate/scripts/play.input",
        "--frames",
        "180",
        "--headless",
        "--audio-out",
        "{{tmp}}/a.pcm"
      ],
      "expect_exit": 0,
      "required_env": true,
      "expect_file_hash": { "file": "{{tmp}}/a.pcm", "fnv64": "8B9F456C57B82565" },
      "note": "pinned to the canonical reference checkpoint (EMU_GATE_V1) at goldens/gate_reference.emu_gate"
    },
    {
      "name": "gate_replay_determinism",
      "binary": "{{env:LABS_NES_GATE_BIN}}",
      "args": [
        "--selfcheck-replay"
      ],
      "expect_exit": 0,
      "required_env": true
    }
  ]
}